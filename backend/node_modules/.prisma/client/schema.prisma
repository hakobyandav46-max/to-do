model Account {
  id                    String    @id @default(cuid())
  user                  User      @relation(fields: [userId], references: [id])
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @db.Timestamptz(3)
  updatedAt             DateTime  @db.Timestamptz(3)
}

model Session {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  createdAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model TodoUser {
  id Int @id @default(autoincrement())

  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  todos     Todo[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Todo {
  id Int @id @default(autoincrement())

  text      String  @unique
  completed Boolean @default(false)

  todoUser   TodoUser @relation(fields: [todoUserId], references: [id])
  todoUserId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  emailVerified  Boolean
  image          String?
  createdAt      DateTime   @db.Timestamptz(3)
  updatedAt      DateTime   @db.Timestamptz(3)
  sessions       Session[]
  accounts       Account[]
  verificationId String?
  todoUser       TodoUser[]
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)
}
